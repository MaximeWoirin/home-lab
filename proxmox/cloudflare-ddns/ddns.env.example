# Required Cloudflare API token with Zone:Read and DNS:Edit permissions.
CF_API_TOKEN=

# Required comma-separated DNS record names.
CF_DOMAIN_NAMES=

# Optional DNS record settings.
CF_TTL=1
CF_PROXIED=false
CF_COMMENT=

# Set to false to skip public IPv6 discovery and AAAA record synchronization.
CF_ENABLE_IPV6=true
